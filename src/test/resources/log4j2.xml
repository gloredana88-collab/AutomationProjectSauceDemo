<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <!-- Console -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>
        </Console>

        <!-- File -->
        <RollingFile
                name="File"
                fileName="target/logs/suites/automation.log"
                filePattern="target/logs/archive/automation-%d{yyyy-MM-dd}-%i.log.gz">

            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>

            <Policies>
                <TimeBasedTriggeringPolicy
                        interval="1"
                        modulate="true"/>

                <SizeBasedTriggeringPolicy
                        size="20 MB"/>
            </Policies>

            <DefaultRolloverStrategy max="30"/>

        </RollingFile>

    </Appenders>


    <Loggers>

        <Root level="INFO">

            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>